{
  "manifest_version": 3,
  "name": "LeadDock — Google Business Capture",
  "version": "2.7.0",
  "description": "Save the Google Maps / Google Search business profile you are viewing as a lead in your local LeadDock CRM.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:18765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Save to LeadDock (Alt+Shift+L)",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open LeadDock on the current business"
    }
  }
}
